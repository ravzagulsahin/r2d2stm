  27:Core/Src/RC522.c **** 
  28:Core/Src/RC522.c **** 	  // even though we are calling transfer frame once, we are really sending
  29:Core/Src/RC522.c **** 	  // two 8-bit frames smooshed together-- sending two 8 bit frames back to back
  30:Core/Src/RC522.c **** 	  // results in a spike in the select line which will jack with transactions
  31:Core/Src/RC522.c **** 	  // - top 8 bits are the address. Per the spec, we shift the address left
  32:Core/Src/RC522.c **** 	  //   1 bit, clear the LSb, and clear the MSb to indicate a write
  33:Core/Src/RC522.c **** 	  // - bottom 8 bits are the data bits being sent for that address, we send them
  34:Core/Src/RC522.c **** 	RC522_SPI_Transfer((addr<<1)&0x7E);	
